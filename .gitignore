# ====================
# Project Specific
# ====================
# Uploaded data files (users' datasets)
uploads/
data/uploaded_files/
*.csv
*.xlsx
*.xls
*.json

# Exported files
exports/
downloads/
output/

# Logs
logs/
*.log

# Temporary files
temp/
tmp/
*.tmp

# Database files (if you add DB later)
*.db
*.sqlite
*.sqlite3

# Generated reports
reports/
*.pdf
*.png
*.jpg
*.jpeg

# ====================
# Development & Testing
# ====================
# Test data (sample files you create for testing)
# Uncomment if you want to ignore test data
# tests/data/
# sample_data/

# Performance profiling
*.prof

# ====================
# Documentation
# ====================
# Documentation build files
docs/_build/
docs/.doctrees/

# ====================
# Deployment
# ====================
# Docker
docker-compose.override.yml

# Heroku
*.env.local

# ====================
# Secrets & Credentials
# ====================
# IMPORTANT: Never commit these!
secrets.toml
.secrets
credentials.json
config.ini
*.pem
*.key
*.cert

# API keys and tokens
.api_keys
.tokens

# ====================
# Miscellaneous
# ====================
# Backup files
*.bak
*.backup

# Archive files
*.zip
*.tar
*.gz
*.rar
*.7z

# Large files (GitHub has 100MB limit)
*.large

# Node modules (if you add any JS later)
node_modules/

# Package files
*.deb
*.rpm
*.pkg

# ====================
# Keep These (Whitelist)
# ====================
# Sample data for demo purposes
!sample_data/
!assets/sample_data/
!assets/*.png
!assets/*.jpg

# Configuration templates
!config.template.toml
!.env.example